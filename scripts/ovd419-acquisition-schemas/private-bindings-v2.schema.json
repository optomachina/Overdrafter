{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "OVD419-PRIVATE-BINDING-DATA-NOT-AUTHORITY-v2"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "readPlanSha256": {
      "const": "58f007868ada20901080b914cfeb0c7f90d1169166a62bdb25314a4ea3bc5354"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740989
            },
            "resourceVersion": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/_=-]{1,256}$"
            },
            "configuration": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "uid",
            "generation",
            "resourceVersion",
            "configuration"
          ]
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740989
            },
            "resourceVersion": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/_=-]{1,256}$"
            },
            "configuration": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "uid",
            "generation",
            "resourceVersion",
            "configuration"
          ]
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "account": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "secretVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "inventory": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        },
        "controls": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "egress": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "job",
        "service",
        "snapshot",
        "account",
        "secretVersion",
        "inventory",
        "controls",
        "egress"
      ]
    },
    "candidateConfiguration": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshotScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 223,
          "pattern": "^[a-z0-9][a-z0-9._-]{1,221}[a-z0-9]$"
        },
        "object": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n\\u0000*?\\[\\]#]{1,1024}$"
        },
        "maxBytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "metageneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "etag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/_=-]{1,256}$"
        }
      },
      "required": [
        "bucket",
        "object",
        "maxBytes",
        "generation",
        "metageneration",
        "etag"
      ]
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "enum": [
            "1",
            "2",
            "4",
            "8"
          ]
        },
        "memory": {
          "type": "string",
          "pattern": "^([1-9]|[12][0-9]|3[0-2])Gi$"
        },
        "taskSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "tasks": {
          "const": 1
        },
        "parallelism": {
          "const": 1
        },
        "retries": {
          "const": 0
        }
      },
      "required": [
        "cpu",
        "memory",
        "taskSeconds",
        "tasks",
        "parallelism",
        "retries"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogue": {
          "const": true
        },
        "executionRepresentation": {
          "const": true
        },
        "baselineSafeForTemporaryManifest": {
          "const": true
        },
        "controlsEncodingVerified": {
          "const": true
        }
      },
      "required": [
        "catalogue",
        "executionRepresentation",
        "baselineSafeForTemporaryManifest",
        "controlsEncodingVerified"
      ]
    },
    "catalogueFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completedExecutionRepresentationFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acquisitionSourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "diagnosticSourceCommit": {
      "const": "e9c1073c47277f7ba7709655d94d4a399e78fffa"
    },
    "inputManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "capturedAt",
    "readPlanSha256",
    "baseline",
    "candidateConfiguration",
    "snapshotScope",
    "principal",
    "resources",
    "compatibility",
    "catalogueFingerprint",
    "completedExecutionRepresentationFingerprint",
    "acquisitionSourceCommit",
    "diagnosticSourceCommit",
    "inputManifestSha256"
  ],
  "$comment": "Slice A proposed full binding schema; only v2 provenance is implemented now. Complete resource validation, writer and consumer integration remain later gates. acquisitionSourceCommit and inputManifestSha256 must also equal the independently qualified input, not just match syntax."
}
