select pg_temp.ovd815_as('00000000-0815-4000-8000-000000000002', 'authenticated', 'aal2');
set local role authenticated;
select throws_ok($$select public.api_admin_grant_fixture_heal_standing_approval('Synthetic selector standing approval')$$, '42501', 'platform_admin_required', 'admin_grant_requires_platform_admin: verified non-admin AAL2 refused');
