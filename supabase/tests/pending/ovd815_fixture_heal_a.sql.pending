select is((select count(*)::integer from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(1,3)), 0, 'publish_rejects_internal_or_held_result: failed scenario 1 leaves no package');
select is((select count(*)::integer from public.published_quote_options o join public.published_quote_packages p on p.id=o.package_id where p.quote_run_id=pg_temp.ovd815_id(1,3)), 0, 'publish_rejects_internal_or_held_result: failed scenario 1 leaves no options');
select is((select count(*)::integer from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(2,3)), 0, 'publish_rejects_internal_or_held_result: failed scenario 2 leaves no package');
select is((select count(*)::integer from public.published_quote_options o join public.published_quote_packages p on p.id=o.package_id where p.quote_run_id=pg_temp.ovd815_id(2,3)), 0, 'publish_rejects_internal_or_held_result: failed scenario 2 leaves no options');
select is((select count(*)::integer from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(3,3)), 0, 'publish_rejects_internal_or_held_result: failed scenario 3 leaves no package');
select is((select count(*)::integer from public.published_quote_options o join public.published_quote_packages p on p.id=o.package_id where p.quote_run_id=pg_temp.ovd815_id(3,3)), 0, 'publish_rejects_internal_or_held_result: failed scenario 3 leaves no options');
select is((select count(*)::integer from public.published_quote_options where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(4,3))), 1, 'publish_rejects_internal_or_held_result: clean scenario 4 has one option');
select is((select count(*)::integer from public.published_quote_options where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(5,3))), 1, 'publish_rejects_internal_or_held_result: clean scenario 5 has one option');
