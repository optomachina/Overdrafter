select ok(exists (select 1 from private.fixture_heal_events where ref_id=(select id from ovd815_ids where label='approval') and kind='standing_revoked' and provider is null and actor='00000000-0815-4000-8000-000000000001' and actor_kind='admin'), 'admin revoke: standing_revoked audit attributed to admin');
