select pg_temp.ovd815_as('00000000-0815-4000-8000-000000000001', 'authenticated', 'aal1');
set local role authenticated;
select throws_ok($$select public.api_admin_revoke_fixture_heal_standing_approval((select id from ovd815_ids where label='approval'),'Synthetic standing approval revoked')$$, '42501', 'aal2_required', 'admin_revoke_requires_aal2: verified platform admin AAL1 refused');
