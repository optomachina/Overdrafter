set local role authenticated;
select throws_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(1,1),pg_temp.ovd815_id(1,3),null,true)$$, 'P0001', 'fixture_heal_result_not_publishable', 'publish_rejects_internal_or_held_result: internal marker');
select throws_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(2,1),pg_temp.ovd815_id(2,3),null,true)$$, 'P0001', 'fixture_heal_result_not_publishable', 'publish_rejects_internal_or_held_result: held marker despite instant status');
select throws_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(3,1),pg_temp.ovd815_id(3,3),null,true)$$, 'P0001', 'fixture_heal_result_not_publishable', 'publish_rejects_internal_or_held_result: malformed marker fails closed');
select lives_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(4,1),pg_temp.ovd815_id(4,3),null,true)$$, 'publish_rejects_internal_or_held_result: unmarked publishes');
select lives_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(5,1),pg_temp.ovd815_id(5,3),null,true)$$, 'publish_rejects_internal_or_held_result: explicit false markers publishes');
select lives_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(6,1),pg_temp.ovd815_id(6,3),null,true)$$, 'publish_rejects_internal_or_held_result: clean before internal marking publishes');
select lives_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(7,1),pg_temp.ovd815_id(7,3),null,true)$$, 'publish_rejects_internal_or_held_result: clean before hold marking publishes');
select lives_ok($$select public.api_publish_quote_package(pg_temp.ovd815_id(8,1),pg_temp.ovd815_id(8,3),null,true)$$, 'publish_rejects_internal_or_held_result: clean selection control publishes');
