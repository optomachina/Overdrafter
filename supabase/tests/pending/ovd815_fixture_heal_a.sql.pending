select throws_ok($$insert into public.published_quote_options (package_id,organization_id,requested_quantity,option_kind,label,published_price_usd,source_vendor_quote_id,source_vendor_quote_offer_id,markup_policy_version) values (pg_temp.ovd815_id(1,6),'00000000-0815-4000-8000-000000000003',1,'lowest_cost','Synthetic direct option',120,null,pg_temp.ovd815_id(1,5),'ovd815-synthetic')$$, 'P0001', 'fixture_heal_result_not_publishable', 'publish_rejects_internal_or_held_result: direct owner offer-only insert');
select throws_ok($$insert into public.published_quote_options (package_id,organization_id,requested_quantity,option_kind,label,published_price_usd,source_vendor_quote_id,source_vendor_quote_offer_id,markup_policy_version) values (pg_temp.ovd815_id(1,6),'00000000-0815-4000-8000-000000000003',1,'lowest_cost','Synthetic direct option',120,pg_temp.ovd815_id(4,4),pg_temp.ovd815_id(1,5),'ovd815-synthetic')$$, 'P0001', 'fixture_heal_result_not_publishable', 'publish_rejects_internal_or_held_result: direct owner clean result plus internal offer insert');
select throws_ok($$insert into public.published_quote_options (package_id,organization_id,requested_quantity,option_kind,label,published_price_usd,source_vendor_quote_id,source_vendor_quote_offer_id,markup_policy_version) values (pg_temp.ovd815_id(1,6),'00000000-0815-4000-8000-000000000003',1,'lowest_cost','Synthetic direct option',120,'00000000-0815-4000-8000-000000999999',null,'ovd815-synthetic')$$, 'P0001', 'fixture_heal_source_unreadable', 'commitment guard: missing result fails closed before FK');
select throws_ok($$insert into public.published_quote_options (package_id,organization_id,requested_quantity,option_kind,label,published_price_usd,source_vendor_quote_id,source_vendor_quote_offer_id,markup_policy_version) values (pg_temp.ovd815_id(1,6),'00000000-0815-4000-8000-000000000003',1,'lowest_cost','Synthetic direct option',120,null,'00000000-0815-4000-8000-000000999999','ovd815-synthetic')$$, 'P0001', 'fixture_heal_source_unreadable', 'commitment guard: missing offer fails closed before FK');
-- Mark only after publication, to exercise selection defense in depth.
update public.vendor_quote_results set raw_payload='{"fixtureHeal":{"v":1,"internal":true}}'
where id=pg_temp.ovd815_id(6,4);
update public.vendor_quote_results set raw_payload='{"fixtureSanity":{"held":true}}'
where id=pg_temp.ovd815_id(7,4);
select throws_ok($$update public.published_quote_options set source_vendor_quote_id=source_vendor_quote_id where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(6,3))$$, 'P0001', 'fixture_heal_result_not_publishable', 'publish_rejects_internal_or_held_result: unchanged source recheck refuses marked-later result');
select pg_temp.ovd815_as('00000000-0815-4000-8000-000000000002','authenticated','aal1');
set local role authenticated;
select throws_ok($$select public.api_select_quote_option((select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(6,3)),(select id from public.published_quote_options where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(6,3))),null)$$, 'P0001', 'fixture_heal_offer_not_selectable', 'select_quote_option_rejects_internal_offer: internal added after publish');
select throws_ok($$select public.api_select_quote_option((select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(7,3)),(select id from public.published_quote_options where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(7,3))),null)$$, 'P0001', 'fixture_heal_offer_not_selectable', 'select_quote_option_rejects_internal_offer: hold added after publish');
select lives_ok($$select public.api_select_quote_option((select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(8,3)),(select id from public.published_quote_options where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(8,3))),null)$$, 'select_quote_option_rejects_internal_offer: clean option selectable');
select throws_ok($$select public.api_set_job_selected_vendor_quote_offer(pg_temp.ovd815_id(6,1),pg_temp.ovd815_id(6,5))$$, 'P0001', 'fixture_heal_offer_not_selectable', 'select_quote_option_rejects_internal_offer: direct-offer RPC refuses internal source');
select lives_ok($$select public.api_set_job_selected_vendor_quote_offer(pg_temp.ovd815_id(4,1),pg_temp.ovd815_id(4,5))$$, 'select_quote_option_rejects_internal_offer: direct-offer RPC allows clean source');
reset role;
select is((select count(*)::integer from public.client_selections where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(6,3))), 0, 'select_quote_option_rejects_internal_offer: scenario 6 has 0 selection rows');
select is((select count(*)::integer from public.client_selections where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(7,3))), 0, 'select_quote_option_rejects_internal_offer: scenario 7 has 0 selection rows');
select is((select count(*)::integer from public.client_selections where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(8,3))), 1, 'select_quote_option_rejects_internal_offer: scenario 8 has 1 selection rows');
select throws_ok($$insert into public.client_selections (package_id,option_id,organization_id,selected_by) values ((select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(6,3)),(select id from public.published_quote_options where package_id=(select id from public.published_quote_packages where quote_run_id=pg_temp.ovd815_id(6,3))),'00000000-0815-4000-8000-000000000003','00000000-0815-4000-8000-000000000002')$$, 'P0001', 'fixture_heal_offer_not_selectable', 'select_quote_option_rejects_internal_offer: direct owner selection refused');
select * from finish();
rollback;
