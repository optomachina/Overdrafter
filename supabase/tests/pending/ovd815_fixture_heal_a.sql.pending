select throws_ok($$select public.api_admin_revoke_fixture_heal_standing_approval('00000000-0815-4000-8000-000000000100','Synthetic revoke reason')$$, '42501', null, 'admin ACL: anon cannot revoke');
reset role;
select pg_temp.ovd815_as(null, 'service_role', 'aal1');
set local role service_role;
select throws_ok($$select public.api_admin_grant_fixture_heal_standing_approval('Synthetic selector standing approval')$$, '42501', null, 'admin ACL: service_role cannot grant');
select throws_ok($$select public.api_admin_revoke_fixture_heal_standing_approval('00000000-0815-4000-8000-000000000100','Synthetic revoke reason')$$, '42501', null, 'admin ACL: service_role cannot revoke');
reset role;
select pg_temp.ovd815_as('00000000-0815-4000-8000-000000000001', 'authenticated', 'aal2');
set local role authenticated;
select throws_ok($$select public.api_admin_grant_fixture_heal_standing_approval('')$$, '22023', 'reason_required_min_10_chars', 'admin reason: 0 chars refused');
