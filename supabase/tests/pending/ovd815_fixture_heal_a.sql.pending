-- Owner cannot mutate immutable evidence even with RLS bypass.
select throws_ok($$update private.fixture_heal_events set reason='Synthetic edited reason'$$, '42501', 'fixture_heal_events is append-only', 'events_update_delete_truncate_rejected: update refused as owner');
select throws_ok($$delete from private.fixture_heal_events$$, '42501', 'fixture_heal_events is append-only', 'events_update_delete_truncate_rejected: delete refused as owner');
select throws_ok($$truncate private.fixture_heal_events$$, '42501', 'fixture_heal_events is append-only', 'events_update_delete_truncate_rejected: truncate refused as owner');
select throws_ok($$delete from private.fixture_heal_standing_approvals$$, '42501', 'fixture_heal_standing_approvals is append-only', 'standing evidence: delete refused as owner');
select throws_ok($$truncate private.fixture_heal_standing_approvals$$, '42501', 'fixture_heal_standing_approvals is append-only', 'standing evidence: truncate refused as owner');
select throws_ok($$update private.fixture_heal_standing_approvals set revoked_at=null where id=(select id from ovd815_ids where label='approval')$$, '42501', 'fixture_heal_standing_approvals is append-only', 'standing evidence: un-revoke refused as owner');
select throws_ok($$update private.fixture_heal_standing_approvals set reason='Synthetic edited reason'$$, '42501', 'fixture_heal_standing_approvals is append-only', 'standing evidence: edit reason refused as owner');
-- Synthetic publication fixtures: each scenario has a separate job/run/part/result/offer.
-- Prices below are arbitrary synthetic values, never provider quotes.
insert into public.organizations (id,name,slug)
values ('00000000-0815-4000-8000-000000000003','OVD815 synthetic organization','ovd815-synthetic');
insert into public.organization_memberships (organization_id,user_id,role)
values ('00000000-0815-4000-8000-000000000003','00000000-0815-4000-8000-000000000002','internal_estimator');
insert into public.pricing_policies (id,organization_id,version,markup_percent,currency_minor_unit)
values ('00000000-0815-4000-8000-000000000004','00000000-0815-4000-8000-000000000003','ovd815-synthetic',20,0.01);

-- Types: 1 job, 2 part, 3 run, 4 result, 5 offer, 6 direct package, 7 direct option.
create function pg_temp.ovd815_id(p_scenario integer, p_kind integer)
returns uuid language sql immutable set search_path = pg_catalog as $$
  select ('00000000-0815-4000-8000-' || pg_catalog.lpad((1000 + p_scenario * 10 + p_kind)::text,12,'0'))::uuid;
$$;
grant execute on function pg_temp.ovd815_id(integer,integer) to authenticated, service_role;
create function pg_temp.ovd815_seed(p_scenario integer, p_payload jsonb)
returns void language plpgsql set search_path = '' as $$
begin
  insert into public.jobs (id,organization_id,created_by,title,status,active_pricing_policy_id)
  values (pg_temp.ovd815_id(p_scenario,1),'00000000-0815-4000-8000-000000000003',
    '00000000-0815-4000-8000-000000000002','Synthetic fixture-heal job','internal_review','00000000-0815-4000-8000-000000000004');
  insert into public.parts (id,job_id,organization_id,name,normalized_key)
  values (pg_temp.ovd815_id(p_scenario,2),pg_temp.ovd815_id(p_scenario,1),
    '00000000-0815-4000-8000-000000000003','Synthetic fixture-heal part','ovd815-synthetic-part');
  insert into public.quote_runs (id,job_id,organization_id,initiated_by,status)
  values (pg_temp.ovd815_id(p_scenario,3),pg_temp.ovd815_id(p_scenario,1),
    '00000000-0815-4000-8000-000000000003','00000000-0815-4000-8000-000000000002','completed');
  insert into public.vendor_quote_results
    (id,quote_run_id,part_id,organization_id,vendor,requested_quantity,status,total_price_usd,lead_time_business_days,raw_payload)
  values (pg_temp.ovd815_id(p_scenario,4),pg_temp.ovd815_id(p_scenario,3),pg_temp.ovd815_id(p_scenario,2),
    '00000000-0815-4000-8000-000000000003','xometry',1,'instant_quote_received',100,7,p_payload);
  insert into public.vendor_quote_offers
    (id,vendor_quote_result_id,organization_id,offer_key,supplier,lane_label,total_price_usd,lead_time_business_days,sort_rank,provenance_status)
  values (pg_temp.ovd815_id(p_scenario,5),pg_temp.ovd815_id(p_scenario,4),
    '00000000-0815-4000-8000-000000000003','synthetic-exact','Synthetic','Synthetic exact offer',100,7,0,'trusted_adapter');
end;
$$;

select pg_temp.ovd815_seed(1,'{"fixtureHeal":{"v":1,"internal":true}}'::jsonb);
select pg_temp.ovd815_seed(2,'{"fixtureSanity":{"held":true}}'::jsonb);
select pg_temp.ovd815_seed(3,'{"fixtureHeal":{"v":9}}'::jsonb);
select pg_temp.ovd815_seed(4,'{}'::jsonb);
select pg_temp.ovd815_seed(5,'{"fixtureSanity":{"held":false},"fixtureHeal":{"v":1,"internal":false}}'::jsonb);
select pg_temp.ovd815_seed(6,'{}'::jsonb);
select pg_temp.ovd815_seed(7,'{}'::jsonb);
select pg_temp.ovd815_seed(8,'{}'::jsonb);
