select is((select attempts from private.fixture_heal_cleanup_items where id=(select id from ovd815_ids where label='cleanup')), 2, 'worker cleanup: second removal increments attempts');
reset role;
select pg_temp.ovd815_as(null, 'service_role', 'aal1');
