select lives_ok($$select public.api_worker_fixture_heal_record_cleanup_item(pg_catalog.jsonb_build_object('id',(select id from ovd815_ids where label='cleanup')) || '{"state": "verified"}'::jsonb)$$, 'worker cleanup: verified after removal');
select throws_ok($$select public.api_worker_fixture_heal_record_cleanup_item(pg_catalog.jsonb_build_object('id',(select id from ovd815_ids where label='cleanup')) || '{"state": "created"}'::jsonb)$$, '22023', 'invalid_cleanup_transition', 'worker cleanup: verified is terminal');
select throws_ok($$select public.api_worker_fixture_heal_record_cleanup_item(pg_catalog.jsonb_build_object('id',(select id from ovd815_ids where label='cleanup')) || '{"state": "verified", "itemRef": "rewrite"}'::jsonb)$$, '22023', 'invalid_payload', 'worker cleanup: reference cannot change after creation');
