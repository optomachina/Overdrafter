select pg_temp.ovd815_as('00000000-0815-4000-8000-000000000002', 'authenticated', 'aal2');
set local role authenticated;
select throws_ok($$select public.api_admin_revoke_fixture_heal_standing_approval((select id from ovd815_ids where label='approval'),'Synthetic standing approval revoked')$$, '42501', 'platform_admin_required', 'admin revoke: verified non-admin AAL2 refused');
reset role;
select pg_temp.ovd815_as('00000000-0815-4000-8000-000000000001', 'authenticated', 'aal2');
set local role authenticated;
select lives_ok($$select public.api_admin_revoke_fixture_heal_standing_approval((select id from ovd815_ids where label='approval'),'Synthetic standing approval revoked')$$, 'admin revoke: verified AAL2 platform admin succeeds');
select throws_ok($$select public.api_admin_revoke_fixture_heal_standing_approval((select id from ovd815_ids where label='approval'),'Synthetic standing approval revoked')$$, 'P0002', 'standing_approval_not_active', 'admin revoke: second revoke refused');
