reset role;
select ok(exists (select 1 from private.fixture_heal_standing_approvals where id=(select id from ovd815_ids where label='approval') and revoked_at is null), 'admin grant: active row exists');
select ok(exists (select 1 from private.fixture_heal_events where ref_id=(select id from ovd815_ids where label='approval') and kind='standing_granted' and provider is null and actor='00000000-0815-4000-8000-000000000001' and actor_kind='admin'), 'admin grant: standing_granted audit attributed to admin');
reset role;
select pg_temp.ovd815_as(null, 'service_role', 'aal1');
set local role service_role;
select is((public.api_worker_fixture_heal_active_standing_approval()->>'id')::uuid, (select id from ovd815_ids where label='approval'), 'worker approval: active grant id returned');
