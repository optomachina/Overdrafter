{
  "permissions": {
    "deny": [
      "Edit(/supabase/migrations/**)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__create_project",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__create_edge_function_secret",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__merge_branch",
      "mcp__supabase__reset_branch",
      "mcp__supabase__rebase_branch",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__restore_project",
      "mcp__supabase__pause_project",
      "mcp__supabase__create_project",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__create_edge_function_secret",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__apply_migration",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__execute_sql",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__merge_branch",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__reset_branch",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__rebase_branch",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__create_branch",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__delete_branch",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__restore_project",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__pause_project",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__create_project",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__deploy_edge_function",
      "mcp__fb51b900-5d04-4884-9f50-844879db0029__create_edge_function_secret"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-migrations.mjs",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-migrations.mjs",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
