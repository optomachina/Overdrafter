  "fields": [
    {
      "id": "hero-eyebrow",
      "sectionId": "hero",
      "label": "Eyebrow",
      "role": "eyebrow",
      "text": "One part, idea to shelf",
      "multiline": false
    },
    {
      "id": "hero-headline",
      "sectionId": "hero",
      "label": "Headline lockup (one line per row)",
      "role": "headline",
      "text": "OverDrafter\nYour agent for\nBuilding hardware",
      "multiline": true
    },
    {
      "id": "hero-lede",
      "sectionId": "hero",
      "label": "Lede",
      "role": "body",
      "text": "From idea to part to assembly to shelf. Today it reads your drawing and requests quotes from providers in parallel.",
      "multiline": true
    },
    {
      "id": "hero-cta-primary",
      "sectionId": "hero",
      "label": "Primary button label",
      "role": "cta",
      "text": "Create account",
      "multiline": false
    },
    {
      "id": "hero-cta-secondary",
      "sectionId": "hero",
      "label": "Secondary button label",
      "role": "cta",
      "text": "Follow one part",
      "multiline": false
    },
    {
      "id": "hero-beta-note",
      "sectionId": "hero",
      "label": "Beta note",
      "role": "body",
      "text": "Automatic vendor collection is only in the free, invitation-only Founding Beta.",
      "multiline": true
    },
    {
      "id": "ch1-band",
      "sectionId": "ch1",
      "label": "Band tag",
      "role": "eyebrow",
      "text": "You bring",
      "multiline": false
    },
    {
      "id": "ch1-headline",
      "sectionId": "ch1",
      "label": "Headline",
      "role": "headline",
      "text": "Agents turn ideas into models",
      "multiline": false
    },
    {
      "id": "ch1-sentence",
      "sectionId": "ch1",
      "label": "Body sentence",
      "role": "body",
      "text": "Coming soon: describe a part and an agent drafts the model. Today you bring a model from your own CAD tool.",
      "multiline": true
    },
    {
      "id": "ch2-band",
      "sectionId": "ch2",
      "label": "Band tag",
      "role": "eyebrow",
      "text": "You bring",
      "multiline": false
    },
    {
      "id": "ch2-headline",
      "sectionId": "ch2",
      "label": "Headline",
      "role": "headline",
      "text": "Agents turn parts into assemblies",
      "multiline": false
    },
    {
      "id": "ch2-sentence",
      "sectionId": "ch2",
      "label": "Body sentence",
      "role": "body",
      "text": "Coming soon: agents mate parts into an assembly. Today you bring parts you have already designed, like this sample assembly, FLT-GIMBAL.",
      "multiline": true
    },
    {
      "id": "ch3-band",
      "sectionId": "ch3",
      "label": "Band tag",
      "role": "eyebrow",
      "text": "OverDrafter does this",
      "multiline": false
    },
    {
      "id": "ch3-headline",
      "sectionId": "ch3",
      "label": "Headline",
      "role": "headline",
      "text": "Agents turn drawings into quotes",
      "multiline": false
    },
    {
      "id": "ch3-sentence",
      "sectionId": "ch3",
      "label": "Body sentence",
      "role": "body",
      "text": "The agent reads material, finish, tolerance and quantity off the drawing and carries them into every request.",
      "multiline": true
    },
    {
      "id": "ch4-band",
      "sectionId": "ch4",
      "label": "Band tag",
      "role": "eyebrow",
      "text": "OverDrafter does this",
      "multiline": false
    },
    {
      "id": "ch4-headline",
      "sectionId": "ch4",
      "label": "Headline",
      "role": "headline",
      "text": "Works autonomously, quotes in parallel",
      "multiline": false
    },
    {
      "id": "ch4-sentence",
      "sectionId": "ch4",
      "label": "Body sentence",
      "role": "body",
      "text": "One request goes to all six providers at once, so none waits in line behind another.",
      "multiline": true
    },
    {
      "id": "ch5-band",
      "sectionId": "ch5",
      "label": "Band tag",
      "role": "eyebrow",
      "text": "OverDrafter does this",
      "multiline": false
    },
    {
      "id": "ch5-headline",
      "sectionId": "ch5",
      "label": "Headline",
      "role": "headline",
      "text": "Compare the best supplier for every part",
      "multiline": false
    },
    {
      "id": "ch5-sentence",
      "sectionId": "ch5",
      "label": "Body sentence",
      "role": "body",
      "text": "Price and lead time sit side by side, so the best fit for each part is easy to see.",
      "multiline": true
    },
    {
      "id": "ch6-band",
      "sectionId": "ch6",
      "label": "Band tag",
      "role": "eyebrow",
      "text": "OverDrafter does this",
      "multiline": false
    },
    {
      "id": "ch6-headline",
      "sectionId": "ch6",
      "label": "Headline",
      "role": "headline",
      "text": "Quote the whole project at once",
      "multiline": false
    },
    {
      "id": "ch6-sentence",
      "sectionId": "ch6",
      "label": "Body sentence",
      "role": "body",
      "text": "Put every part of the build in one project, and each part gets its own six quotes to compare.",
      "multiline": true
    },
    {
      "id": "ch7-band",
      "sectionId": "ch7",
      "label": "Band tag",
      "role": "eyebrow",
      "text": "What you get · The goal · illustration",
      "multiline": false
    },
    {
      "id": "ch7-headline",
      "sectionId": "ch7",
      "label": "Headline",
      "role": "headline",
      "text": "Agents turn quotes into hardware",
      "multiline": false
    },
    {
      "id": "ch7-sentence",
      "sectionId": "ch7",
      "label": "Body sentence",
      "role": "body",
      "text": "Coming soon: the finished part, then the assembly, then out on the shelf. This is the goal, not a feature today.",
      "multiline": true
    },
    {
      "id": "ch7-beat1-title",
      "sectionId": "ch7",
      "label": "Beat 1 title",
      "role": "headline",
      "text": "First part finished",
      "multiline": false
    },
    {
      "id": "ch7-beat1-body",
      "sectionId": "ch7",
      "label": "Beat 1 body",
      "role": "body",
      "text": "A finished bracket, machined to what the drawing says.",
      "multiline": false
    },
    {
      "id": "ch7-beat2-title",
      "sectionId": "ch7",
      "label": "Beat 2 title",
      "role": "headline",
      "text": "Five parts assembled as FLT-GIMBAL",
      "multiline": false
    },
    {
      "id": "ch7-beat2-body",
      "sectionId": "ch7",
      "label": "Beat 2 body",
      "role": "body",
      "text": "With every part in hand, the five parts come together.",
      "multiline": false
    },
    {
      "id": "ch7-beat3-title",
      "sectionId": "ch7",
      "label": "Beat 3 title",
      "role": "headline",
      "text": "Out on the shelf",
      "multiline": false
    },
    {
      "id": "ch7-beat3-body",
      "sectionId": "ch7",
      "label": "Beat 3 body",
      "role": "body",
      "text": "The finished unit rides a conveyor to a shelf, which is where your build is going.",
      "multiline": true
    },
