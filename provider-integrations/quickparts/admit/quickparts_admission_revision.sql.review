-- REVIEW-ONLY. NOT A MIGRATION. NOT APPLIED. DO NOT RUN AS-IS.
-- Generated by `npm run fixture:onboard -- quickparts --stage=admit` (OVD-687).
--
-- Approved admission revision for Quickparts. Admission is a protected
-- operator action recorded through the registry's audited revision history,
-- never a migration. The <...> placeholders are intentionally invalid SQL and
-- must be replaced by reviewed values (OVD-379 completeness constraints apply).

update private.quote_provider_admission_policies
set admission_state = 'approved',
    generic_dispatch_enabled = true,
    policy_revision = 'quickparts-generic-<yyyy-mm-dd>.v1',
    evidence_reference = 'OVD-687',
    permission_basis = <'written_provider_authorization' | 'provider_terms_allow_automation'>,
    supported_processes = array[<reviewed process_types>]::public.process_types[],
    accepted_file_extensions = array['3mf', 'iges', 'igs', 'obj', 'step', 'stl', 'stp', 'wrl'],
    session_owner = 'overdrafter_managed',
    reviewed_by = '<reviewer user uuid>',
    reviewed_at = pg_catalog.now(),
    expires_at = null,
    change_reason = 'approval_recorded'
where provider = 'quickparts'::public.vendor_name;

-- Rollback: record a new revision with admission_state = 'disabled',
-- generic_dispatch_enabled = false and change_reason = 'policy_disabled',
-- then revoke issued permits with private.revoke_provider_dispatch_permit.
