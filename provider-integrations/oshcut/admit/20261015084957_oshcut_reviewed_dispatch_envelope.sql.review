-- DEFERRED 2026-10-20: Blaine requires OSH Cut default-off for 1.0.
-- Future review material only; do not promote or apply under PR #743.
-- REVIEW-ONLY. NOT A MIGRATION. NOT APPLIED.
-- Generated by `npm run fixture:onboard -- oshcut --stage=admit` (OVD-687).
-- Proposed migration name: supabase/migrations/20261015084957_oshcut_reviewed_dispatch_envelope.sql
-- (the next free timestamp when generated; re-check before moving it).
--
-- Record the reviewed OSH Cut quote-only dispatch envelope
-- (oshcut-quote-envelope.v1). It must match a code-reviewed entry in
-- REVIEWED_PROVIDER_DISPATCH_ENVELOPES (worker/src/providerDispatchEnvelope.ts).
--
-- This row alone admits nothing. Generic dispatch additionally requires an
-- approved admission revision with generic_dispatch_enabled = true (see
-- oshcut_admission_revision.sql.review, an operator action, not a migration),
-- the automatic_quote_collection rollout, organization enablement, and a
-- worker deployed with oshcut in WORKER_LIVE_ADAPTERS plus its session secret.
--
-- Rollback (operational): set withdrawn_at on this row. Rows cannot be deleted.

insert into private.provider_dispatch_envelope_reviews (
  provider,
  envelope_id,
  envelope_version,
  evidence_reference,
  permit_ttl_seconds
)
select
  'oshcut'::public.vendor_name,
  'oshcut-quote-envelope',
  1,
  'OVD-677',
  7200
where not exists (
  select 1
  from private.provider_dispatch_envelope_reviews review
  where review.provider = 'oshcut'::public.vendor_name
    and review.withdrawn_at is null
);
