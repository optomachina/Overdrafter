{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overdrafter.local/schemas/provider-registry.v1.schema.json",
  "title": "ProviderRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "stableEgressRequiredKey",
    "providers"
  ],
  "properties": {
    "$schema": { "const": "./provider-registry.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "stableEgressRequiredKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,49}$",
      "description": "Live adapter that must remain on the governed stable-NAT worker. Not a production-authorization flag."
    },
    "oneDotZero": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,49}$" },
      "description": "Reviewed list of provider keys in the 1.0 scope, sorted, each present in providers. The provider permissions lint derives its required 1.0 coverage from this list."
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/providerEntry" }
    }
  },
  "$defs": {
    "providerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "liveAdapter", "sessionSecrets", "egress"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,49}$" },
        "liveAdapter": {
          "type": "boolean",
          "description": "When true, a live deploy may list this key in WORKER_LIVE_ADAPTERS. Default for new entries is false. Never grants production authority."
        },
        "sessionSecrets": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/sessionSecret" }
        },
        "egress": { "enum": ["stable_nat", "none"] }
      }
    },
    "sessionSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretNameEnv", "requiredWhenListed"],
      "properties": {
        "secretNameEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,80}$",
          "description": "Environment variable that holds the Secret Manager secret name, never a secret value."
        },
        "mountEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,80}$",
          "description": "Worker environment variable that receives the named secret."
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/var/secrets/[a-z0-9-]+/storage-state\\.json$",
          "description": "Fixed Cloud Run secret mount path. Not a secret value."
        },
        "requiredWhenListed": { "type": "boolean" }
      }
    }
  }
}
