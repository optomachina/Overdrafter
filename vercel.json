{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "codex/**": false,
      "cursor/**": false
    }
  },
  "functions": {
    "api/mobile-auth.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/auth/mobile/start",
      "destination": "/api/mobile-auth?action=start"
    },
    {
      "source": "/auth/mobile/provider-callback",
      "destination": "/api/mobile-auth?action=provider-callback"
    },
    {
      "source": "/auth/mobile/complete",
      "destination": "/api/mobile-auth?action=complete"
    },
    {
      "source": "/auth/mobile/callback",
      "destination": "/api/mobile-auth?action=callback"
    },
    {
      "source": "/auth/mobile/bootstrap",
      "destination": "/api/mobile-auth?action=bootstrap"
    },
    {
      "source": "/api/admin-operations",
      "destination": "/api/admin-operations"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/jarvis/session",
      "destination": "/api/jarvis/gate"
    },
    {
      "source": "/api/jarvis",
      "destination": "/api/jarvis/miss"
    },
    {
      "source": "/api/jarvis/:path*",
      "destination": "/api/jarvis/miss"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/mobile-auth?action=cleanup",
      "schedule": "17 4 * * *"
    }
  ]
}
