{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mobile-auth.ts": {
      "maxDuration": 60
    },
    "api/portfolio-status.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/portfolio.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/mobile/start",
      "destination": "/api/mobile-auth?action=start"
    },
    {
      "source": "/auth/mobile/provider-callback",
      "destination": "/api/mobile-auth?action=provider-callback"
    },
    {
      "source": "/auth/mobile/complete",
      "destination": "/api/mobile-auth?action=complete"
    },
    {
      "source": "/auth/mobile/callback",
      "destination": "/api/mobile-auth?action=callback"
    },
    {
      "source": "/auth/mobile/bootstrap",
      "destination": "/api/mobile-auth?action=bootstrap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/mobile-auth?action=cleanup",
      "schedule": "17 4 * * *"
    }
  ]
}
