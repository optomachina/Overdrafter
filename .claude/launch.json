{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "worker", "run", "dev"],
      "port": 3001
    },
    {
      "name": "supabase",
      "runtimeExecutable": "supabase",
      "runtimeArgs": ["start"],
      "port": 54321
    }
  ]
}
