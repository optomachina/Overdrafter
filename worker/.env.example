SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

WORKER_MODE=simulate
WORKER_LIVE_ADAPTERS=xometry
WORKER_NAME=quote-worker-1
WORKER_POLL_INTERVAL_MS=5000
WORKER_HTTP_HOST=0.0.0.0
# OVD-829: on only after docs/migration-drafts/ovd-828-s1.sql is applied. There
# is no default daily cap; only an admin-set cap is enforced. Off counts a capped
# supplier in process; on uses the durable counter. A failed or missing cap read
# is no cap. The kill switch fails closed either way.
WORKER_PROVIDER_DURABLE_DISPATCH_CAP=off

WORKER_TEMP_DIR=./tmp
QUOTE_ARTIFACT_BUCKET=quote-artifacts

PORT=8080
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CAPTURE_TRACE=false
PLAYWRIGHT_BROWSER_TIMEOUT_MS=30000
PLAYWRIGHT_DISABLE_SANDBOX=false
PLAYWRIGHT_DISABLE_DEV_SHM_USAGE=true

XOMETRY_STORAGE_STATE_PATH=./state/xometry-storage-state.json
XOMETRY_STORAGE_STATE_JSON=
# Used only when WORKER_LIVE_ADAPTERS includes fictiv (OVD-673); production
# Fictiv dispatch also needs database admission (docs/workflows/ovd673-fictiv-live-readiness.md).
FICTIV_STORAGE_STATE_PATH=./state/fictiv-storage-state.json
# Quickparts (OVD-674) reads its session from the generic vendor map, e.g.
# QUOTE_VENDOR_STORAGE_STATE_PATHS={"quickparts":"/abs/path/quickparts-storage-state.json"}.
# Production dispatch also needs database admission (docs/workflows/ovd674-quickparts-live-readiness.md).
# Weerg (OVD-675) uses the same map, e.g. {"weerg":"/abs/path/weerg-storage-state.json"};
# see docs/workflows/ovd675-weerg-live-readiness.md.
# OPENAI_API_KEY=replace-with-worker-secret
# OPENROUTER_API_KEY=replace-with-worker-secret
DRAWING_EXTRACTION_MODEL=gpt-5.4
DRAWING_EXTRACTION_ENABLE_MODEL_FALLBACK=false
# fixture:onboard geomiq session
# (OVD-687; default-off, no value)
# Geomiq reads its session from the generic vendor map, e.g.
# QUOTE_VENDOR_STORAGE_STATE_PATHS={"geomiq":"/abs/path/geomiq-storage-state.json"}.
# A live deploy would also need GEOMIQ_STORAGE_STATE_SECRET_NAME (Secret Manager name only).
# Production dispatch also needs admission; see docs/workflows/geomiq-live-readiness.md.
# fixture:onboard rmfg session
# (OVD-687; default-off, no value)
# RMFG is an API provider: it authenticates with an API key, not a browser session.
# A live deploy would need RMFG_API_KEY_SECRET_NAME (Secret Manager name only), mounted as RMFG_API_KEY.
# Production dispatch also needs admission; see docs/workflows/rmfg-live-readiness.md.
# fixture:onboard oshcut session
# (OVD-687; default-off, no value)
# OSH Cut reads its session from the generic vendor map, e.g.
# QUOTE_VENDOR_STORAGE_STATE_PATHS={"oshcut":"/abs/path/oshcut-storage-state.json"}.
# A live deploy would also need OSHCUT_STORAGE_STATE_SECRET_NAME (Secret Manager name only).
# Production dispatch also needs admission; see docs/workflows/oshcut-live-readiness.md.
